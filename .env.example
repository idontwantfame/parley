# Discord (required)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional nickname while recording (default: [REC] Meeting Bot). A per-server
# Bot name set in Settings → Behavior takes precedence (shown as "[REC] <name>").
# DISCORD_RECORDING_NICKNAME="[REC] Notes Bot"

# Speech-to-text (transcription)
# Default provider is the local faster-whisper sidecar at STT_URL. To use a
# cloud Whisper API instead, set OPENAI_API_KEY below and pick the OpenAI
# provider per-server in the dashboard's Settings (or `/setup stt_provider:openai`).
STT_URL=http://127.0.0.1:8000
# Optional shared access key for the sidecar. Set the same value for Parley and
# the sidecar; Parley then sends it as "Authorization: Bearer <key>" on every
# request. Set it whenever the sidecar is reachable from anything but Parley
# (a published port, another host). Can also be set from the dashboard.
# STT_API_KEY=
# Sidecar tuning (optional). Device/compute auto-detect (GPU when available,
# else CPU); override with STT_DEVICE=cpu|cuda and STT_COMPUTE. Batched inference
# is on by default (1.7-2.6x faster) — STT_BATCH_SIZE tunes the batch, 0 disables.
# STT_DEVICE=
# STT_COMPUTE=
# STT_BATCH_SIZE=

# Summarizer provider keys (only the one you use is required)
GEMINI_API_KEY=
# OPENAI_API_KEY is shared by the OpenAI summarizer and the OpenAI STT provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENCODE_API_KEY=
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_URL=http://127.0.0.1:11434
# Optional. A dashboard address that Discord recipients can open.
# WEB_PUBLIC_URL=https://parley.example.com

# Optional: persistent data dir (defaults to /data if present, else cwd)
DATA_DIR=

# Automatically save Markdown and JSON after each processed meeting.
# Set 0 to disable. Restart after changing these settings.
AUTO_EXPORT=1
# How long to keep audio when the server enables "Keep recordings" (0 = indefinitely).
AUDIO_RETENTION_DAYS=30
# Optional. Delete finished meetings (completed, failed or empty) outside
# campaigns after this many days, with their audio and exports.
# Zero preserves transcripts, summaries, and exports indefinitely.
MEETING_RETENTION_DAYS=0
# Empty means DATA_DIR/exports (./exports locally, /data/exports in Docker).
EXPORT_DIR=

# Web dashboard (optional). WEB_UI=1 starts it with the bot.
# Bind host stays 127.0.0.1 for safety; Docker overrides this to 0.0.0.0 and
# maps the port to the host's localhost only. The UI requires a login — the
# default account is admin / admin, and you must set a new password before the
# dashboard unlocks. Set TRUSTED_PROXY if a non-loopback reverse proxy fronts it.
WEB_UI=
# Preferred port. If it's taken, the next free port is used (3001, 3002, …).
WEB_UI_PORT=3000
WEB_UI_HOST=127.0.0.1

# Single sign-on for the dashboard (OpenID Connect: Authentik, Keycloak,
# Authelia, Pocket ID, Google, ...). Off unless OIDC_ENABLED=true; also editable
# by an admin in the dashboard. Register a confidential client with the
# redirect URI  <PUBLIC_URL>/api/auth/oidc/callback  and an RSA/EC signing key.
# OIDC_ENABLED=false
# OIDC_ISSUER=https://auth.example.com/application/o/parley/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email
# Claim holding the user's groups (read from userinfo if not in the ID token).
# OIDC_GROUPS_CLAIM=groups
# Optional: only members of at least one of these groups may sign in.
# OIDC_ALLOWED_GROUPS=parley-users,parley-admins
# Optional: members are made admin (and non-members demoted) at every sign-in.
# OIDC_ADMIN_GROUP=parley-admins
# Create accounts on first SSO sign-in (false: only existing/linked accounts).
# OIDC_AUTO_CREATE=true
# OIDC_BUTTON_LABEL=Sign in with SSO
# The dashboard's public base URL (required for SSO; never derived from requests).
# PUBLIC_URL=https://parley.example.com
# Turn password sign-in off. Takes effect only once an admin has signed in with
# SSO under the current settings (Parley then writes OIDC_VERIFIED, a hash of
# those settings; changing any of them un-verifies). Only an SSO-linked admin
# can turn it off from the dashboard.
# Recovery if the identity provider is down while password sign-in is off:
# set PASSWORD_LOGIN=true here and restart Parley.
# PASSWORD_LOGIN=true
# OIDC_VERIFIED=   (managed by Parley; leave alone)
